Meta.DisplayName=Maple2
Meta.Description=MapleStory 2 game channel server (MS2Community/Maple2). Runs the Game server natively; World, Login, Web and MySQL run outside AMP.
Meta.OS=Linux
Meta.AarchSupport=Unknown
Meta.Arch=x86_64
Meta.Author=Local
Meta.URL=https://github.com/MS2Community/Maple2
Meta.DisplayImageSource=
Meta.EndpointURIFormat=
Meta.ConfigManifest=maple2config.json
Meta.MetaConfigManifest=maple2metaconfig.json
Meta.ConfigRoot=maple2.kvp
Meta.MinAMPVersion=2.5.0.8
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=This channel must reach the World server on the host (127.0.0.1). Run it WITHOUT a container.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=2
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=4062fb1c-4cd0-490e-96d4-c9a91d9e664f
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False
App.DisplayName=Maple2
App.RootDir=./maple2/
App.BaseDirectory=./maple2/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=Maple2.Server.Game\bin\amp\net8.0\Maple2.Server.Game.exe
App.ExecutableLinux=Maple2.Server.Game/bin/amp/net8.0/Maple2.Server.Game
App.WorkingDir=Maple2.Server.Game/bin/amp/net8.0
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}} {{InstancedFlag}}{{CustomArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"DB_IP":"127.0.0.1","DOTNET_SYSTEM_GLOBALIZATION_INVARIANT":"1","DOTNET_SYSTEM_GLOBALIZATION_PREDEFINED_CULTURES_ONLY":"0"}
App.CommandLineParameterFormat=-{0}={1}
App.CommandLineParameterDelimiter= 
App.ExitMethod=OS_CLOSE
App.ExitTimeout=30
App.ExitString=
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ForceIPBinding=False
App.SupportsIPv6=True
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[maple2ports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=GamePort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=100
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=Password123
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=ping
App.TelnetLoginFormat={0}
App.UpdateSources=@IncludeJson[maple2updates.json]
App.PreStartStages=[]
App.UserActions=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.SmartExcludeExemptions=["*.cfg","*.conf","*.config","*.ini","*.json","*.xml","*.properties","*.kvp","*.yml","*.yaml","*.toml","*.lua"]
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=
App.MonitorDirectChildOnly=False
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=\e\[(\d+;)*(\d+)?[ABCDHJKfmsu]|\e\[?[?\>\=\da-z]+
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=
Console.AppReadyRegex=GameServer started on Port:\d+
Console.UserJoinRegex=\[AMP\] JOIN (?<username>.+?) \((?<userid>\d+)\)
Console.UserLeaveRegex=\[AMP\] LEAVE (?<username>.+?) \((?<userid>\d+)\)
Console.UserChatRegex=
Console.UpdateAvailableRegex=
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={"Kick": "kick {{userid}}"}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
